NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_EMAIL=shuoyuqc@163.com
# 认证迁移期开关；正式切换时设为 local
AUTH_BACKEND=supabase
NEXT_PUBLIC_AUTH_BACKEND=supabase
# local 认证使用；至少 32 位随机值，禁止提交真实值
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
AUTH_BASE_URL=https://syqcflow.cn
# 密码重置邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 存储迁移期开关；正式切换时设为 cos
STORAGE_BACKEND=supabase
NEXT_PUBLIC_STORAGE_BACKEND=supabase
# COS 服务端凭证，禁止使用 NEXT_PUBLIC_ 前缀
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET_INSPECTION_PHOTOS=
COS_BUCKET_ORDER_ATTACHMENTS=
# 公共访问域名；可配置 COS 默认域名或自定义 CDN 域名
COS_INSPECTION_PHOTOS_BASE_URL=
COS_ORDER_ATTACHMENTS_BASE_URL=
NEXT_PUBLIC_COS_INSPECTION_PHOTOS_BASE_URL=
NEXT_PUBLIC_COS_ORDER_ATTACHMENTS_BASE_URL=
# 迁移阶段：国内 PostgreSQL 连接串（仅服务端使用，禁止 NEXT_PUBLIC_ 前缀）
DATABASE_URL=postgresql://qcflow:your-password@127.0.0.1:5432/qcflow
# 迁移期数据源开关（supabase = 现网；pg = 仅对已完成迁移的接口生效）
DATA_BACKEND=supabase
